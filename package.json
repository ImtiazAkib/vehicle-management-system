{
  "name": "vehicle-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:linux": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier **/*.{ts,tsx,js,mjs,html,scss,json,md} --check",
    "format:write": "prettier **/*.{ts,tsx,js,mjs,html,scss,json,md} --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run verify:data-model && npm run verify:accounts && npm run verify:vehicles && npm run verify:scheduling && npm run verify:bookings && npm run verify:marketplace && npm run verify:orders && npm run verify:invoices && npm run verify:reports",
    "seed:super-admin": "tsx --env-file-if-exists=.env.local scripts/seed-super-admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "send:reminders": "tsx --env-file-if-exists=.env.local scripts/send-reminders.ts",
    "verify:data-model": "tsx --env-file-if-exists=.env.local scripts/verify-data-model.ts",
    "verify:accounts": "tsx --env-file-if-exists=.env.local scripts/verify-accounts.ts",
    "verify:vehicles": "tsx --env-file-if-exists=.env.local scripts/verify-vehicles.ts",
    "verify:scheduling": "tsx --env-file-if-exists=.env.local scripts/verify-scheduling.ts",
    "verify:bookings": "tsx --env-file-if-exists=.env.local scripts/verify-bookings.ts",
    "verify:marketplace": "tsx --env-file-if-exists=.env.local scripts/verify-marketplace.ts",
    "verify:orders": "tsx --env-file-if-exists=.env.local scripts/verify-orders.ts",
    "verify:invoices": "tsx --env-file-if-exists=.env.local scripts/verify-invoices.ts",
    "verify:reports": "tsx --env-file-if-exists=.env.local scripts/verify-reports.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "5.7.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.8",
    "lucide-react": "1.28.0",
    "mongoose": "9.9.1",
    "nanoid": "5.1.6",
    "next": "16.3.0",
    "nodemailer": "9.0.4",
    "nuqs": "2.9.5",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "schema-dts": "2.0.0",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@cspell/eslint-plugin": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-tailwind-canonical-classes": "1.4.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.7",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
