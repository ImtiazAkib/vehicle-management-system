# Log level: fatal | error | warn | info | debug | trace  (read from step 1)
LOG_LEVEL=info

# Absolute origin the app is served from. Used for absolute links and metadata (step 2).
APP_BASE_URL=http://localhost:3000

# Allow search engines to index the site (step 2). Off by default so staging stays out of the
# index — set to true only on production.
ROBOTS_ENABLED=false

# Whether the app sits behind a proxy trusted to set X-Forwarded-For (step 18). Off by default: a
# wrong "true" lets a client forge its own address, slipping past the per-caller rate limits. Turn
# it on only with a real proxy — nginx must be configured to:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
TRUSTED_PROXY=false

# MongoDB connection string. Required (validated from step 1). The database name is NOT taken from
# this string — the app passes it explicitly, so an Atlas URI pasted without its path segment still
# writes to the right database.
# Local:   mongodb://127.0.0.1:27017/vehicle-utilities
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session tokens, at least 32 characters. Required from step 4.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Total bytes the GridFS bucket (vehicle & product images, message attachments, invoice PDFs) may
# hold (step 9). Optional — defaults to 512 MiB. The per-file cap and the upload quota guard measure
# against it.
STORAGE_CAP_BYTES=

# SMTP settings for outgoing email — verification, password reset, maintenance reminders (step 6 on).
# Leave SMTP_HOST blank to select the log transport, which writes each message (with its link) to the
# logger, so the whole flow can be walked with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address on outgoing mail, e.g. "Vehicle Utilities <no-reply@vusms.example>".
SMTP_FROM=

# --- Optional integrations (disabled when unset) --------------------------------
# SMS reminders via Twilio (step 15). Absent => the SMS channel is disabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Card payments via Stripe (step 13). Absent => card payments are disabled; other methods still work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Seeding only ---------------------------------------------------------------
# Read by `npm run seed:super-admin` (step 6), never by the app. Set them for that one command rather
# than committing them here, so the password stays out of the repo:
#
#   SEED_SUPER_ADMIN_NAME="Platform Owner" \
#   SEED_SUPER_ADMIN_EMAIL="owner@vusms.example" \
#   SEED_SUPER_ADMIN_PASSWORD="..." \
#   npm run seed:super-admin
