{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["lorem-ipsum"],
  "ignorePaths": [
    "package.json",
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    "**/*.json",
    "**/*.md"
  ],
  "ignoreRegExpList": ["/%[0-9A-Fa-f]{2}/g", "/\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}/g"],
  "words": [
    "HSTS",
    "Menlo",
    "Poppins",
    "STARTTLS",
    "Segoe",
    "autorestart",
    "backdrop",
    "browsable",
    "clickjacking",
    "commitlint",
    "cooldown",
    "crawlable",
    "datetime",
    "forgeable",
    "gridfs",
    "jose",
    "linecap",
    "llms",
    "llmstxt",
    "maxlength",
    "metacharacter",
    "metacharacters",
    "mongodb",
    "mongoose",
    "nanoid",
    "nextjs",
    "nodemailer",
    "nosniff",
    "nuqs",
    "odometer",
    "officedocument",
    "oklch",
    "opengraph",
    "openxmlformats",
    "passwordless",
    "pino",
    "prerenders",
    "presentationml",
    "ratelimits",
    "schedulable",
    "shadcn",
    "spreadsheetml",
    "topbar",
    "transactable",
    "twilio",
    "uppercased",
    "vercel",
    "vusms",
    "webp",
    "wordprocessingml"
  ]
}
